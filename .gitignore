# Local secrets. API keys must be injected by the backend process environment.
.env
.env.*
**/.env
**/.env.*
*.pem
*.p12
*.key

# Generated data and caches.
**/__pycache__/
**/.pytest_cache/
p2p/data/
p2p/src/node_modules/
p2p/tests/

# Training workspace: datasets, annotations, runs and base weights stay local.
p2p/training/

# Model artifacts are ignored except for the inference weight shipped with the app.
*.pt
*.onnx
*.engine
!p2p/models/slide-seg.pt
